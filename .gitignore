# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local editor / AI tool settings
.claude/
.vscode/
.idea/

# logs
*.log

# ── Private running data (never commit) ──────────────────────
# Raw Strava exports and anything derived from them before review.
/private-strava-imports/
/.import-tmp/
*.import.json
# GPS / activity files, in any folder
*.gpx
*.gpx.gz
*.tcx
*.tcx.gz
*.fit
*.fit.gz
# Strava bulk-export archives
export_*.zip
strava*.zip

# ── Credentials ──────────────────────────────────────────────
# (.env* is already ignored above) Other credential files:
*.key
*credentials*.json
*token*.json
supabase/.temp/

# The settings TEMPLATE is safe to commit (no real values)
!.env.example
