# Copy this file to .env.local and fill in the values (never commit .env.local).
# Supabase → Project Settings → API Keys.

# Your project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# The PUBLISHABLE key (starts with sb_publishable_). Do NOT use the secret key.
SUPABASE_PUBLISHABLE_KEY=

# Whose public dashboard /running shows (matches profiles.handle in seed.sql).
RUNNING_ARCHIVE_HANDLE=rose
